          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features01 fantasym5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Cards</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n        </select>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"color\" title=\"Active Color\" value=\"#b93e5d\" name=\"activeColor\" condition=\"showCardTitle\" selected>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\">\n        <input type=\"color\" title=\"BG 1\" value=\"#feebba\" name=\"cardBg_1\" selected>\n        <input type=\"color\" title=\"BG 2\" value=\"#e4e3f5\" name=\"cardBg_2\" selected>\n        <input type=\"color\" title=\"BG 3\" value=\"#e2eff0\" name=\"cardBg_3\" selected>\n        <input type=\"color\" title=\"BG 4\" value=\"#ffd3dd\" name=\"cardBg_4\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/fantasym5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/fantasym5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-9\">\n                <div class=\"content-wrapper\">\n                    <div class=\"content-wrap content-wrap_1\">\n                        <div class=\"title-wrapper\">\n                            <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label\">ONE SYSTEM. EVERY QUOTE.</p>\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Make Quoting Easier for Your Business</b></h2>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Manual calculations, spreadsheets and disconnected pricing information can make quoting slower and harder to manage. Runwrk brings your products, pricing and quote process into one place, helping your team work more consistently while giving you the option to let customers get quotes online.</p>\n                        </div>\n                        <div class=\"cards-wrapper\">\n                            <div class=\"item-wrap\" mbr-if=\"cardAmount > 1\">\n                                <div class=\"item-wrapper card_2\">\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Customer-Facing Calculator</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Put your calculator on your website and let customers select what they need, see estimated pricing and submit their quote request without having to call or email your team.\n                                        </p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href=\"https://mobiri.se\" class=\"btn btn-black-outline\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-img\">\n                                        <img src=\"@PROJECT_PATH@/assets/images/image3.webp\" alt=\"Mobirise Website Builder\">\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item-wrap\" mbr-if=\"cardAmount > 3\">\n                                <div class=\"item-wrapper card_4\">\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>DFY — We Build It For You</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Tell us what you sell and how you price it. Our team will build and configure your quote calculator for you, so you can start using it without spending time learning or setting up the system.\n                                        </p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href=\"https://mobiri.se\" class=\"btn btn-black-outline\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                    <div class=\"item-img\">\n                                        <img src=\"@PROJECT_PATH@/assets/images/image17.webp\" alt=\"Mobirise Website Builder\">\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"mbr-section-btn main-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                <a href=\"https://mobiri.se\" class=\"btn item-btn btn-black card-wrap\" data-app-placeholder=\"Type Text\">\n                                    <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                    ABOUT PARTY ROOM\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"content-wrap content-wrap_2\">\n                        <div class=\"item-wrap\">\n                            <div class=\"item-wrapper card_1\">\n                                <div class=\"card-box\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Internal Business Tool</b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                        Give your team one place to manage products, pricing, options and quotes. Keep everyone working from the same information and make your quoting process more consistent.\n                                    </p>\n                                    <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href=\"https://mobiri.se\" class=\"btn btn-black-outline\" data-app-placeholder=\"Type Text\">\n                                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                            LEARN MORE\n                                        </a>\n                                    </div>\n                                </div>\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/image14.webp\" alt=\"Mobirise Website Builder\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item-wrap\" mbr-if=\"cardAmount > 2\">\n                            <div class=\"item-wrapper card_3\">\n                                <div class=\"card-box\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>DIY — Build It Yourself</b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                        You know your business best. Set up your products, pricing and rules yourself, make changes whenever you need, and keep complete control of your quote system.\n                                    </p>\n                                    <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href=\"https://mobiri.se\" class=\"btn btn-black-outline\" data-app-placeholder=\"Type Text\">\n                                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                            LEARN MORE\n                                        </a>\n                                    </div>\n                                </div>\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/image4.webp\" alt=\"Mobirise Website Builder\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item-wrap\" mbr-if=\"cardAmount > 4\">\n                            <div class=\"item-wrapper card_1\">\n                                <div class=\"card-box\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Built Around Your Business</b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                        Every business has different products, pricing and rules. Runwrk gives you the flexibility to create a quoting process that fits the way your business actually works.\n                                    </p>\n                                    <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                        <a href=\"https://mobiri.se\" class=\"btn btn-black-outline\" data-app-placeholder=\"Type Text\">\n                                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                            LEARN MORE\n                                        </a>\n                                    </div>\n                                </div>\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/image11.webp\" alt=\"Mobirise Website Builder\">\n       