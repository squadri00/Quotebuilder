          "_name": "list01",
          "_sourceTheme": "fantasym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 fantasym5\" group=\"List\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Container BG\" value=\"#a0e1e1\" name=\"containerBg\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon BG\" value=\"#eb547a\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row content-wrap justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-4\">\n                            <div class=\"title-wrapper\">\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label\">GROW YOUR BUSINESS</p>\n                                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .main-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Revenue Generation</b></h2>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrap, .mbr-section-btn\">\n                                    Discover how Meccora helps your workshop generate more revenue by reducing missed opportunities, improving customer retention, and automating follow-ups. From deferred work tracking to service reminders, every feature is designed to keep customers returning and your business growing.\n                                </p>\n                                <div class=\"mbr-section-btn main-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a href=\"https://mobiri.se\" class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                        GET STARTED\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-8\">\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>How do you predict future/pipeline revenue?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Every service record has an estimated price (expected future job value) plus an actual cost\n<br>(what was charged). The dashboard rolls these up into a pipeline number — projected income\n<br>from upcoming due services and deferred work.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href=\"https://mobiri.se\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                       <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>How does Meccora actually make me more money, not just organize records?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Three ways: automated reminders bring lapsed customers back before they go to a competitor,\n<br>the deferred-work tracker resurfaces declined jobs (real money customers said \"not today\" to),\n<br>and email marketing campaigns let you re-target old customers with offers.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>What is \"deferred work\" and how does it recover revenue?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">When a customer declines recommended work (e.g. brakes at $400), staff flag it. It shows on\n<br>your dashboard until you follow up and call the customer — often with a small discount to close\n<br>it. It's revenue sitting on the table, not lost — the system just won't let you forget it.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>What is \"deferred work\" and how does it recover revenue?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">When a customer declines recommended work (e.g. brakes at $400), staff flag it. It shows on\n<br>your dashboard until you follow up and call the customer — often with a small discount to close\n<br>it. It's revenue sitting on the table, not lost — the system just won't let you forget it.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>What about customers who've disappeared completely?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">The system can surface anyone who hasn't been back in 6–12 months, so you can reach out\n<br>before they're gone for good — most shops never even notice this happening.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Does this replace me manually calling customers?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">No — reminders are automatic, but the deferred-work follow-up call is still you or your staff. The\n<br>system just makes sure it never falls through the cracks; the human call is what actually closes\n<br>the job.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <!-- addition lines -->\n\n \n                       \n                            \n                        </div>\n                    </div>\n                    <div class=\"container-fluid container-wrapper\">\n                        <div class=\"container-wrap card-wrap tl-large-radius tr-large-radius\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
