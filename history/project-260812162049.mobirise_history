   <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/apexm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7f7f7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row content-wrap justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverseContent}\" mbr-if=\"showLabel || showTitle || showSubtitle\">\n                        <div class=\"col-12 col-lg-4\">\n                            <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                                <div class=\"label-wrap\">\n                                    <div class=\"marker-wrap\" mbr-if=\"showMarker\"></div>\n                                    <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">Our Mission</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-8\">\n                            <div class=\"title-wrapper\">\n                                <div class=\"title-wrap\">\n                                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrap\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>To build simple, reliable, and effective digital solutions</b></h2>\n                                </div>\n                                <div class=\"subtitle-wrap\">\n                                    <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .subtitle-wrap\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\"><b>that help small and medium businesses.</b></h3>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"row items-wrapper justify-content-center\">\n                        <div class=\"col-12 col-lg-3 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icons mbr-iconfont mbr-iconfont-btn mobi-mbri-lock mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                                </div>\n                                <div class=\"card-box\">\n                                    <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardLabel\" data-app-selector=\".item-label\">\n                                        Our Products\n                                    </p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .mbr-section-btn\"><b>Meccora is our flagship SaaS platform for auto repair shops. We also develop custom digital tools that help businesses streamline operations and work more efficiently.</b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                        Our team of experts brings years of industry knowledge to ensure every home is\n                                        built to the highest standards.\n                                    </p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                        <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                            View More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-3 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icons mbr-iconfont mbr-iconfont-btn mobi-mbri-layers mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                                </div>\n                                <div class=\"card-box\">\n                                    <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardLabel\" data-app-selector=\".item-label\">\n                                        Web Solutions\n                                    </p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .mbr-section-btn\"><b>We design and develop modern, responsive websites that help businesses build a strong online presence and connect with their customers effectively.</b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                        We use modern technologies and creative approaches to design homes that are both\n                                        functional and stylish.\n                                    </p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                        <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                            View More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-3 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icons mbr-iconfont mbr-iconfont-btn mobi-mbri-protect mobi-mbri\" data-app-selector=\".card-icons\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n                                </div>\n                                <div class=\"card-box\">\n                                    <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardLabel\" data-app-selector=\".item-label\">\n                                        Custom Development\n                                    </p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .mbr-section-btn\"><b>From simple tools to complex systems, we build custom applications tailored to your business needs—practical, reliable, and easy to use.</b></h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                        We respect your time by completing projects within agreed deadlines without\n                                        sacrificing quality.\n                                    </p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                        <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                            View More\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
