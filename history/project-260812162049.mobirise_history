          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form01 launchm5\" group=\"Form\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <header>Form</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showCardIcon\" checked>\n        <input type=\"color\" title=\"Icon Bg\" value=\"#334155\" name=\"iconBg\" condition=\"showCardIcon\" selected>\n        <input type=\"color\" title=\"Icon Shadow\" value=\"#cccccc\" name=\"iconShadow\" condition=\"showCardIcon\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"color\" title=\"Input Color\" value=\"#9ca3af\" name=\"inputColor\" selected>\n        <input type=\"color\" title=\"Input BG\" value=\"#f5f5f5\" name=\"inputBg\" selected>\n        <input type=\"color\" title=\"Input Border\" value=\"#e1e7ed\" name=\"inputBorder\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#ff6900\" name=\"activeColor\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"BG\" value=\"#fafafa\" name=\"cardBg\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/launchm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/launchm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-contact-form mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    We're Here to Help\n                                </p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Let's Talk About Your Workshop</h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Whether you have questions about Meccora, need a product demonstration, or want to learn how automated service reminders can help retain more customers, our team is here to help. Fill out the form and we'll get back to you as soon as possible.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"row items-wrapper justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-6 card\">\n                            <div class=\"card-wrapper\">\n                                <div class=\"title-wrap\" mbr-if=\"showCardIcon || showCardTitle ||showCardText\">\n                                    <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                                        <span mbr-icon class=\"card-icon mbr-iconfont card-wrap little-radius mobi-mbri-user mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(250, 250, 250); fill: rgb(250, 250, 250);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                            Let’s Connect\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-4\" data-app-selector=\".item-text\">\n                                            Build your next step.\n                                        </p>\n                                    </div>\n                                </div>\n                                <div mbr-form class=\"mbr-form form-wrap\">\n                                    <form action name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\">\n                                        <div class=\"row\">\n                                            <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">\n                                                Thanks for filling out the form!\n                                            </div>\n                                            <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem!\n                                            </div>\n                                        </div>\n                                        <div class=\"dragArea row\">\n                                            <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"name\">\n                                                <label mbr-text mbr-theme-style=\"display-4\" for=\"name\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Name</label>\n                                                <input type=\"text\" name=\"name\" placeholder=\"John Smith\" data-form-field=\"name\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                                            </div>\n                                            <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email1\">\n                                                <label mbr-text mbr-theme-style=\"display-4\" for=\"email1\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Email</label>\n                                                <input type=\"email\" name=\"email1\" placeholder=\"mobirise@email.com\" data-form-field=\"email1\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                                            </div>\n                                            <div data-for=\"text\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                                                <label mbr-text mbr-theme-style=\"display-4\" for=\"text\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Phone</label>\n                                                <input type=\"text\" name=\"text\" placeholder=\"+24-(745)-232-54\" data-form-field=\"text\" mbr-theme-style=\"display-4\" class=\"form-control\" value>\n                                            </div>\n                                            <div data-for=\"textarea\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                                                <label mbr-text mbr-theme-style=\"display-4\" for=\"textarea\" class=\"form-control-label mbr-fonts-style\" data-app-selector=\".form-control-label\">Message</label>\n                                                <textarea name=\"textarea\" placeholder=\"Your Message\" data-form-field=\"textarea\" mbr-theme-style=\"display-4\" class=\"form-control\"></textarea>\n                                            </div>\n                                            <div class=\"col-md-auto col mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\">\n                                                <a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"btn btn-black\"> Send Now </a>\n                                            </div>\n                                        </div>\n                                    </form>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 card\" mbr-if=\"showImage\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20may20302020252008-04-5920pm-1008x1008.webp\" alt=\"Mobirise Website Builder\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
