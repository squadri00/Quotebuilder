" value=\"@ADDONS_PATH@/fantasym5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row content-wrap justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-4\">\n                            <div class=\"title-wrapper\">\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label\">START HERE</p>\n                                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .main-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Getting Started, Trial &amp; Pricing</b></h2>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrap, .mbr-section-btn\">\n                                    Experience everything Meccora has to offer with a risk-free trial. Whether you're running a small repair shop or managing multiple locations, getting started is simple. Explore every feature, import your existing customer data, and discover how Meccora helps streamline daily operations without long-term commitments or hidden fees.\n                                </p>\n                                <div class=\"mbr-section-btn main-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a href=\"https://mobiri.se\" class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                        GET STARTED\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-8\">\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Can I try it before paying?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Yes, 14-day free trial, full access, no credit card needed.\n                                        </p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href=\"https://mobiri.se\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                       <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Is there a contract, or can I leave anytime?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            No contract. Cancel anytime — you keep access until your current billing period ends.\n                                        </p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Are there any hidden fees?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            No. Checkout shows subtotal, tax, and total before you pay — nothing added after.\n                                        </p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Is there a money-back guarantee?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">No formal refund policy. The safety net is the 14-day free trial (no card required) instead of a\n<br>refund guarantee.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Whose name shows up on my card statement?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Eformics Systems (the parent company that processes payments via Stripe) — not \"Workshop\n<br>Manager.\"</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <!-- addition lines -->\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Can I try it out with fake data before touching real customers?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Yes — every new account is seeded with demo customers, vehicles, and services so you can\n<br>explore safely before adding real ones. A one-click cleanup tool wipes the demo data once\n<br>you're ready to go live.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>Can I bring in my existing customer list, or do I start from zero?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Yes, you can import your current customers and their vehicles from a CSV file — no manual re-\n<br>typing needed.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                            <div class=\"item features-without-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"little-radius mobi-mbri mobi-mbri-success mbr-iconfont\" style=\"color: rgb(254, 239, 121);\"></span>\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\"><b>What actually happens the moment my 14-day trial runs out?</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">You're locked out (data untouched) with an upgrade prompt. Nothing is deleted immediately —\n<br>you get warning emails first, and your data is kept for a while in case you decide to pay.</p>\n                                        <div class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">\n                                                LEARN MORE\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n \n                       \n                            \n                        </div>\n                    </div>\n                    <div class=\"container-fluid container-wrapper\">\n                        <div class=\"container-wrap card-wrap tl-large-radius tr-large-radius\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
