# ─────────────────────────────────────────────────────────────
# QuoteBuilder environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

APP_NAME=QuoteBuilder
# PRODUCTION: set APP_ENV=production and APP_DEBUG=false. Leaving DEBUG
# on in production shows visitors full stack traces (file paths, DB
# queries, sometimes secrets) on any error — never deploy with it true.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match exactly how you actually reach the app in your browser —
# every generated link (emails, quote.store form actions, etc.) is built
# from this. If you're serving through XAMPP's Apache from a subfolder
# under htdocs without a dedicated vhost, include that subfolder, e.g.
# http://localhost/quotebuilder/public — not just http://localhost.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# "daily" rotates to a new file each day and prunes old ones (14-day
# default) instead of one endless laravel.log that fills the disk.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────
# MariaDB/MySQL connection. Every environment (local, staging,
# production) sets its own values here — never hardcode DB
# credentials in code.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quotebuilder
DB_USERNAME=quotebuilder
DB_PASSWORD=

# ── Sessions ────────────────────────────────────────────────
# "database" means login sessions are stored as rows in the
# database instead of files on one server's disk. This is what
# lets the app run behind a load balancer on multiple servers
# later without users getting logged out randomly.
# To move to Redis later: change SESSION_DRIVER=redis and set
# the REDIS_* values below — no code changes needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: set SESSION_SECURE_COOKIE=true once HTTPS is confirmed
# working end-to-end. Leave unset for local http:// development.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# ── File storage ────────────────────────────────────────────
# "public" is the local disk defined in config/filesystems.php.
# All file-saving code should go through Laravel's Storage
# facade (Storage::disk('public')->put(...)) instead of raw
# paths, so switching this disk's driver to S3 later is a
# config change, not a code rewrite.
FILESYSTEM_DISK=public

# ── Queue ───────────────────────────────────────────────────
# "database" means background jobs (future: sending emails,
# generating PDFs) are stored as rows in a "jobs" table and
# picked up by a worker process, instead of running inline and
# making the customer wait. Run the worker with:
#   php artisan queue:work
# To move to Redis/SQS later: change QUEUE_CONNECTION and set
# the matching credentials below — no code changes needed.
QUEUE_CONNECTION=database

# ── Cache ───────────────────────────────────────────────────
# "database" stores cached values as rows instead of files, for
# the same multi-server reason as sessions above.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Only used if SESSION_DRIVER, CACHE_STORE, or QUEUE_CONNECTION
# is switched to "redis" later.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ────────────────────────────────────────────────────
# "log" writes emails to the log file instead of actually
# sending them — safe default for local development. Set a real
# mailer (smtp, ses, postmark, etc.) per environment.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── S3-compatible storage (future) ─────────────────────────
# Only needed once FILESYSTEM_DISK is switched to "s3".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe test-mode keys (from https://dashboard.stripe.com/test/apikeys).
# STRIPE_WEBHOOK_SECRET comes from either the Stripe CLI ("stripe listen")
# or a webhook endpoint configured in the Stripe Dashboard.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
